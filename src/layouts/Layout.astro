---
import '@fontsource-variable/archivo';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrackLine from '../components/TrackLine.astro';
import type { Lang } from '../i18n';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
}

const { title, description, lang = 'es' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Rutas equivalentes en cada idioma: / <-> /en/
const esPath = Astro.url.pathname.replace(/^\/en\/?/, '/');
const enPath = esPath === '/' ? '/en/' : `/en${esPath}`;
const esUrl = new URL(esPath, Astro.site);
const enUrl = new URL(enPath, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  alternateName: site.name,
  url: Astro.site?.toString(),
  jobTitle: lang === 'es' ? 'Desarrollador web' : 'Web developer',
  worksFor: { '@type': 'Organization', name: 'Extreweb', url: site.extreweb },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Miajadas',
    addressRegion: 'Cáceres',
    addressCountry: 'ES',
  },
  email: `mailto:${site.email}`,
  sameAs: [site.github, site.linkedin, site.extreweb],
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf8" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101013" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      // Anti-FOUC: fija el tema antes del primer paint.
      (function () {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <TrackLine />
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
