---
import { useTranslations, type Lang } from '../../i18n'
import { site } from '../../data/site'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = useTranslations(lang)
---

<section class='section' id='extreweb'>
  <div class='container'>
    <div class='extreweb-band'>
      <p class='extreweb-kicker'>{t('extreweb.kicker')}</p>
      <h2 class='extreweb-title'>{t('extreweb.title')}</h2>
      <p class='extreweb-text'>{t('extreweb.text')}</p>
      <a class='extreweb-link' href={site.extreweb} target='_blank' rel='noopener'>
        {t('extreweb.cta')}&nbsp;↗
      </a>
    </div>
  </div>
</section>

<style>
  .extreweb-band {
    padding: var(--space-8) var(--space-6);
    border-left: 3px solid var(--color-accent);
    background-color: var(--color-bg-elevated);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .extreweb-kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .extreweb-title {
    margin-top: var(--space-2);
    font-size: var(--text-xl);
    font-weight: 650;
  }

  .extreweb-text {
    margin-top: var(--space-3);
    max-width: 58ch;
    color: var(--color-text-muted);
  }

  .extreweb-link {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: none;
  }

  .extreweb-link:hover {
    text-decoration: underline;
  }
</style>
